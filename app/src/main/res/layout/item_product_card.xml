<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The Product Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#E2E8F0"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- Brand Name Centered Top (Hidden) -->
            <TextView
                android:id="@+id/tvBrandName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:text="TechZone"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Centered Product Image Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#FFFFFF">

                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/iphonepromaxbac" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Name Title -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ốp lưng iPhone 16 Pro Mipow Premium Slim"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:minLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvProductDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mỏng nhẹ • Chống va đập"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Price Section (Red Discounted Price + Crossed Out Old Price) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="396.000đ"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProductOldPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="440.000đ"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Member Discount Chip -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMemberChip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#EFF6FF">

                <TextView
                    android:id="@+id/tvMemberDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Member giảm 100K"
                    android:textColor="#2563EB"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Row (Delivery Pill 2h Left, Star Center, Blue Heart Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Fast Delivery Direct Graphic Badge Pill (ic_giao_hang.png with overlaid "2 Giờ" text) -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/imgDeliveryIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_giao_hang" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:paddingEnd="10dp"
                        android:text="2 Giờ"
                        android:textColor="@color/white"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Rating Stars with ic_ngoi_sao.png Centered -->
                <LinearLayout
                    android:id="@+id/layoutStarRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgStarIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ngoi_sao" />

                    <TextView
                        android:id="@+id/tvRatingScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="5.0"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Wishlist Heart Button Right-Aligned -->
                <ImageView
                    android:id="@+id/btnWishlistHeart"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Compact Action Buttons Row (Hidden as requested) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetail"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Chi tiết"
                    android:textColor="@color/orange_primary"
                    android:textSize="11sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    app:strokeColor="@color/orange_primary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Đặt hàng"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:backgroundTint="@color/orange_primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Top-Left Red Discount Ribbon Badge (Placed OUTSIDE Card so NEVER clipped!) -->
    <FrameLayout
        android:id="@+id/layoutDiscountBadge"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-2dp"
        android:elevation="10dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/ic_giam_gia" />

        <TextView
            android:id="@+id/tvDiscountPercent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="Giảm 10%"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

</RelativeLayout>